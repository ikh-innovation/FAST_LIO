<launch>
<!-- Launch file for Livox MID360 LiDAR -->

	<arg name="rviz" default="true" />
	<arg name="test_name" default="aristos" />
	<arg name="fast_lio_publish_tf" default="false" />
	<arg name="global_ekf" default="true" />

	<arg name="record" default="false" />
	<arg name="rosbag_name" default="fami_tf0_glb1_rtk1_ldr0_whl1_swcRTK" />

   <group ns="$(arg test_name)">

		<!-- Parameters -->
		<rosparam file="$(find fast_lio)/aristos/config/ekf_global.yaml" command="load" subst_value="True">
			<param name="test_name" value="$(arg test_name)" />
		</rosparam>

		<rosparam file="$(find fast_lio)/aristos/config/ekf_local.yaml" command="load" subst_value="True">
			<param name="test_name" value="$(arg test_name)" />
		</rosparam>

		<rosparam file="$(find fast_lio)/aristos/config/mid360.yaml"  command="load" subst_value="True">
			<param name="fast_lio_publish_tf" value="$(arg fast_lio_publish_tf)" />
		</rosparam>

		<param name="feature_extract_enable" type="bool" value="0"/>
		<param name="point_filter_num" type="int" value="3"/>
		<param name="max_iteration" type="int" value="3" />
		<param name="filter_size_corner" type="double" value="0.5" /> <!-- default --> 
		<param name="filter_size_surf" type="double" value="0.5" />
		<param name="filter_size_map" type="double" value="0.5" />
		<param name="cube_side_length" type="double" value="1000" />
		<param name="runtime_pos_log_enable" type="bool" value="0" />

		<!-- Run FAST-LIO -->
		<node pkg="fast_lio" type="fastlio_mapping" name="laserMapping" output="screen" /> 

		<!--- Run RViz -->
		<group if="$(arg rviz)">
			<node launch-prefix="nice" pkg="rviz" type="rviz" name="rviz" args="-d $(find fast_lio)/aristos/rviz_cfg/loam_livox.rviz" />
		</group>

		<!--- Run Navsat -->
		<include file="$(find fast_lio)/aristos/launch/module_navsat.launch" >
			<arg name="imu_topic" default="imu_raw"/>
			<arg name="gps_topic" default="gps/fix"/>
			<arg name="fast_lio_publish_tf" default="$(arg fast_lio_publish_tf)"/>
			<arg name="global_ekf" default="$(arg global_ekf)"/>
		</include>

		<!-- Multiple maps node -->
		<include file="$(find aristos_maps)/launch/multiple_maps.launch" >
			<arg name="map_file" default="$(env HOME)/.ikh/fields/gr-domokos-field/maps/multimap_environment.yaml"/>
			<arg name="maps_path" default="$(env HOME)/.ikh/fields/gr-domokos-field/maps"/>
		</include>

		<!--- Robot State TF -->
		<include file="$(find fast_lio)/aristos/launch/module_robot_state_publisher.launch" >
			<arg name="test_name" default="$(arg test_name)"/>
		</include>

		<!--- Rosbag record -->
 		<node pkg="rosbag" type="record" name="rosbag_record"
       		args="record -o /home/aristos/catkin_ws/bags/comparison/$(arg rosbag_name) /$(arg test_name)/Odometry /$(arg test_name)/ground_truth /$(arg test_name)/odometry/navsat /$(arg test_name)/odometry/onlyRTK /$(arg test_name)/wheel/odom"
       if="$(arg record)" />

		<!-- <node pkg="tf" type="static_transform_publisher" name="static_publisher" args="-75.9292962362 52.8949042433 0 0 0 -0.264  0.967  /map /camera_init  100"/> -->
    </group>

</launch>

