<launch>
<!-- Launch file for Livox MID360 LiDAR -->
    <include file="$(find fast_lio)/aristos/launch/aristos_mapping_mid360.launch" >
        <arg name="rviz" default="true" />
        <arg name="test_name" default="aristos" />
        <arg name="fast_lio_publish_tf" default="false" />
        <arg name="global_ekf" default="true" />
        <arg name="two_d_mode" default="true" /> 
        <arg name="localization_type" default="lidar" /> <!-- lidar, legacy -->
        <arg name="pmx_type" default="gnss" /> <!-- pmx, no_pmx -->
        <arg name="localization_relay" default="false" /> <!-- allows to relay topics, but relies on the untested fastlio_mapping_halt implementation -->
        <arg name="global_ekf_output_topic" default="ekf/global/pose_estimation_gnss"/> 
        <arg name="field" default="gr-domokos-field" /> 	<!-- gr-domokos-field, it-fondazione-fornasini-field -->

        <!-- The following params should be set together in order to relay onlyRTK topic.
        Either (false, "") or (true, "_relay") 
        Keep in mind that only in no_pmx type will take effect-->
        <arg name="rtk_relay" default="true" /> 
        <arg name="rtk_relay_extension" default="_relay" />

        <arg name="record" default="false" />
        <arg name="rosbag_name" default="under_feat1_fss05_fsm05" />
    </include>

</launch>



<!-- rosbag play -clock bags/trj_vertL_2025-01-29-14-28-35.bag /tf:=tf_mute /aristos/Odometry:=aristos/Odometry_mute /aristos/odometry/gps/onlyRTK_relay:=/aristos/odometry/gps/onlyRTK_relay_mute /aristos/imu/data_relay:=/aristos/imu/data_relay_mute -->
